{%- comment -%}
  Estado de cupos de una experiencia según el inventario de Shopify.
  Uso: {% render 'ca-cupos', product: product, threshold: 10, style: 'badge' | 'line' %}
  - Si el inventario está controlado: muestra "Quedan X cupos" cuando hay pocos (<= threshold).
  - Si no está disponible: "Sin cupos".
{%- endcomment -%}
{%- liquid
  assign ca_tracked = false
  assign ca_cupos = 0
  for v in product.variants
    if v.inventory_management == 'shopify'
      assign ca_tracked = true
      if v.inventory_quantity > 0
        assign ca_cupos = ca_cupos | plus: v.inventory_quantity
      endif
    endif
  endfor
  assign ca_threshold = threshold | default: 10
-%}
{%- if style == 'line' -%}
  {%- if product.available == false -%}
    <p class="ca-stock ca-stock--out"><span class="ca-dot" aria-hidden="true"></span> {{ 'casa_alma.sold_out_date' | t }}</p>
  {%- elsif ca_tracked and ca_cupos <= ca_threshold -%}
    <p class="ca-stock"><span class="ca-dot" aria-hidden="true"></span> {% if ca_cupos == 1 %}{{ 'casa_alma.spots_left_one_html' | t }}{% else %}{{ 'casa_alma.spots_left_other_html' | t: n: ca_cupos }}{% endif %}</p>
  {%- else -%}
    <p class="ca-stock"><span class="ca-dot" aria-hidden="true"></span> {{ 'casa_alma.spots_available' | t }}</p>
  {%- endif -%}
{%- else -%}
  {%- if product.available == false -%}
    <span class="ca-badge ca-badge--soldout">{{ 'casa_alma.sold_out' | t }}</span>
  {%- elsif ca_tracked and ca_cupos <= ca_threshold -%}
    <span class="ca-badge">{% if ca_cupos == 1 %}{{ 'casa_alma.last_spot' | t }}{% else %}{{ 'casa_alma.spots_badge' | t: n: ca_cupos }}{% endif %}</span>
  {%- endif -%}
{%- endif -%}
