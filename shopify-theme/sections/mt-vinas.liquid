{%- capture mt_logos -%}
  {%- for block in section.blocks -%}
    <li class="mt-wine{% if block.settings.logo != blank or block.settings.logo_fallback != blank %} mt-wine--logo{% endif %}" {{ block.shopify_attributes }}>
      {%- capture inner -%}
        {%- if block.settings.logo != blank -%}
          {{ block.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.name, class: 'mt-wine__logo' }}
        {%- elsif block.settings.logo_fallback != blank -%}
          <img class="mt-wine__logo" src="{{ block.settings.logo_fallback | asset_url }}" alt="{{ block.settings.name | escape }}" width="800" height="400" loading="lazy">
        {%- else -%}
          <span class="mt-wine__name">{{ block.settings.name }}</span>
        {%- endif -%}
      {%- endcapture -%}
      {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" target="_blank" rel="noopener">{{ inner }}</a>{%- else -%}{{ inner }}{%- endif -%}
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- if section.settings.layout == 'banner' -%}
  <section class="ca mt-band{% if section.settings.alt_bg %} ca--alt{% endif %}" id="{{ section.settings.anchor | default: 'vinas' | handle }}" aria-labelledby="MtWineTitle-{{ section.id }}" style="--mt-band-speed: {{ section.settings.speed }}s; --mt-band-h: {{ section.settings.logo_height }}px;">
    <div class="ca-container mt-band__head">
      {%- if section.settings.eyebrow != blank -%}<p class="ca-eyebrow" id="MtWineTitle-{{ section.id }}">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="mt-band__line">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="mt-band__viewport">
      <ul class="ca-list mt-band__track">
        {%- assign mt_logos_eager = mt_logos | replace: 'loading="lazy"', 'loading="eager"' -%}
        {{ mt_logos_eager }}
        {%- comment -%} Copia para que la cinta sea continua (oculta a lectores de pantalla) {%- endcomment -%}
        {{ mt_logos_eager | replace: '<li class="mt-wine', '<li aria-hidden="true" class="mt-band__clone mt-wine' | replace: '<a href', '<a tabindex="-1" href' }}
      </ul>
    </div>
  </section>
{%- else -%}
  <section class="ca ca-section mt-wines{% if section.settings.alt_bg %} ca--alt{% endif %}" id="{{ section.settings.anchor | default: 'vinas' | handle }}" aria-labelledby="MtWineTitle-{{ section.id }}">
    <div class="ca-container">
      <div class="ca-head ca-center ca-reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="ca-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <p class="mt-wines__line" id="MtWineTitle-{{ section.id }}">{{ section.settings.text }}</p>
      </div>
      <ul class="ca-list mt-wines__grid">{{ mt_logos }}</ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "MT · Viñas partners",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "ID de ancla",
      "default": "vinas"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Formato",
      "options": [
        {
          "value": "banner",
          "label": "Banner (cinta de logos)"
        },
        {
          "value": "grid",
          "label": "Grilla"
        }
      ],
      "default": "banner"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Alto de los logos (banner)",
      "min": 32,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Duración de una vuelta (banner)",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "s",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "alt_bg",
      "label": "Fondo alternativo",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo",
      "default": "Los vinos de la casa"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Una línea",
      "default": "Seleccionados por nuestro sommelier para cada tiempo."
    }
  ],
  "blocks": [
    {
      "type": "wine",
      "name": "Viña",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Nombre",
          "default": "Viña por confirmar"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo (opcional)",
          "info": "Ideal: logo claro sobre fondo transparente (PNG/SVG)."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (opcional)"
        },
        {
          "type": "text",
          "id": "logo_fallback",
          "label": "Logo de respaldo (archivo del tema)",
          "info": "Uso interno: se muestra mientras no elijas un logo arriba."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "MT · Viñas partners",
      "blocks": [
        {
          "type": "wine",
          "settings": {
            "name": "Viña por confirmar"
          }
        },
        {
          "type": "wine",
          "settings": {
            "name": "Viña por confirmar"
          }
        },
        {
          "type": "wine",
          "settings": {
            "name": "Viña por confirmar"
          }
        },
        {
          "type": "wine",
          "settings": {
            "name": "Viña por confirmar"
          }
        }
      ]
    }
  ]
}
{% endschema %}
