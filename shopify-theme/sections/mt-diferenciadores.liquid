<section class="ca ca-section mt-feats{% if section.settings.alt_bg %} ca--alt{% endif %}" id="{{ section.settings.anchor | default: section.id | handle }}" aria-labelledby="MtFeatTitle-{{ section.id }}">
  <div class="ca-container">
    {%- if section.settings.heading != blank -%}
      <div class="ca-head ca-center ca-reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="ca-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="ca-h2-sm" id="MtFeatTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <ul class="ca-list mt-feats__grid">
      {%- for block in section.blocks -%}
        <li class="mt-feat ca-reveal" {{ block.shopify_attributes }}>
          <span class="ca-pillar__icon">{% render 'ca-icon', icon: block.settings.icon %}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "MT · Diferenciadores",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "ID de ancla", "default": "experiencia" },
    { "type": "checkbox", "id": "alt_bg", "label": "Fondo alternativo", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Por qué Casa Alma" },
    { "type": "text", "id": "heading", "label": "Título (opcional)", "default": "Una noche que no se repite." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Diferenciador",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Ícono",
          "options": [
            { "value": "musica", "label": "Música" },
            { "value": "mesa", "label": "Mesa larga" },
            { "value": "chef", "label": "Chef" },
            { "value": "copa", "label": "Copa de vino" },
            { "value": "plato", "label": "Plato" },
            { "value": "arte", "label": "Arte" },
            { "value": "casa", "label": "Casa" },
            { "value": "estrella", "label": "Estrella" },
            { "value": "calendario", "label": "Calendario" }
          ],
          "default": "musica"
        },
        { "type": "text", "id": "title", "label": "Título", "default": "Artistas nuevos cada semana" },
        { "type": "text", "id": "text", "label": "Una línea", "default": "Ninguna noche se repite." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "MT · Diferenciadores",
      "blocks": [
        { "type": "item", "settings": { "icon": "musica", "title": "Artistas nuevos cada semana", "text": "Ninguna noche se repite." } },
        { "type": "item", "settings": { "icon": "mesa", "title": "Mesa larga, sin rotaciones", "text": "Te sientas y la noche es tuya." } },
        { "type": "item", "settings": { "icon": "chef", "title": "Chef y sommelier invitados", "text": "El equipo rota en cada fecha." } },
        { "type": "item", "settings": { "icon": "copa", "title": "Viñas seleccionadas", "text": "Una copa pensada para cada tiempo." } }
      ]
    }
  ]
}
{% endschema %}
