<section class="ca ca-section mt-feats mt-feats--{{ section.settings.layout }}{% if section.settings.alt_bg %} ca--alt{% endif %}" id="{{ section.settings.anchor | default: section.id | handle }}" aria-labelledby="MtFeatTitle-{{ section.id }}">
  <div class="ca-container">
    {%- if section.settings.heading != blank -%}
      <header class="mt-feats__head ca-reveal">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="ca-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 id="MtFeatTitle-{{ section.id }}">{{ section.settings.heading | newline_to_br }}</h2>
        </div>
        {%- if section.settings.intro != blank -%}<p class="mt-feats__intro">{{ section.settings.intro }}</p>{%- endif -%}
      </header>
    {%- endif -%}
    <ol class="ca-list mt-feats__list">
      {%- for block in section.blocks -%}
        <li class="mt-feat ca-reveal" {{ block.shopify_attributes }}>
          {%- if section.settings.layout == 'fotos' -%}
            <div class="mt-feat__media">
              {%- render 'ca-image', image: block.settings.image, fallback: block.settings.fallback, alt: block.settings.title, sizes: '(min-width: 990px) 25vw, 78vw', widths: '400, 600, 800' -%}
            </div>
          {%- endif -%}
          <span class="mt-feat__num" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          <div class="mt-feat__body">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "MT · Diferenciadores",
  "tag": "div",
  "settings": [
    {
      "type": "select", "id": "layout", "label": "Diseño",
      "options": [
        { "value": "fotos", "label": "Fotos numeradas" },
        { "value": "lista", "label": "Lista editorial (sin fotos)" }
      ],
      "default": "fotos"
    },
    { "type": "text", "id": "anchor", "label": "ID de ancla", "default": "experiencia" },
    { "type": "checkbox", "id": "alt_bg", "label": "Fondo alternativo", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Por qué Casa Alma" },
    { "type": "textarea", "id": "heading", "label": "Título (opcional)", "default": "Una noche que no se repite." },
    { "type": "textarea", "id": "intro", "label": "Texto junto al título (opcional)" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Diferenciador",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto", "info": "Vertical 4:5. Si no eliges una, se usa la foto por defecto." },
        { "type": "text", "id": "fallback", "label": "Foto por defecto (archivo del tema)", "info": "No hace falta tocarlo." },
        { "type": "text", "id": "title", "label": "Título", "default": "Artistas nuevos cada semana" },
        { "type": "text", "id": "text", "label": "Una línea", "default": "Ninguna noche se repite." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "MT · Diferenciadores",
      "blocks": [
        { "type": "item", "settings": { "fallback": "ca-dif-artistas.webp", "title": "Artistas nuevos cada semana", "text": "Ninguna noche se repite." } },
        { "type": "item", "settings": { "fallback": "ca-dif-mesa.webp", "title": "Mesa larga, sin rotaciones", "text": "Te sientas y la noche es tuya." } },
        { "type": "item", "settings": { "fallback": "ca-dif-chef.webp", "title": "Chef y sommelier invitados", "text": "El equipo rota en cada fecha." } },
        { "type": "item", "settings": { "fallback": "ca-dif-vinas.webp", "title": "Viñas seleccionadas", "text": "Una copa pensada para cada tiempo." } }
      ]
    }
  ]
}
{% endschema %}
