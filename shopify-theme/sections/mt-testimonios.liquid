{%- assign visible = section.settings.visible -%}
<section class="ca ca-section{% if section.settings.alt_bg %} ca--alt{% endif %}" id="{{ section.settings.anchor | default: 'opiniones' | handle }}" aria-labelledby="MtRevTitle-{{ section.id }}">
  <div class="ca-container">
    <div class="ca-head ca-center ca-reveal">
      {%- if section.settings.rating != blank -%}
        <p class="mt-rating">
          {%- if section.settings.rating_link != blank -%}<a href="{{ section.settings.rating_link }}" target="_blank" rel="noopener">{{ section.settings.rating }}</a>{%- else -%}{{ section.settings.rating }}{%- endif -%}
        </p>
      {%- endif -%}
      <h2 class="ca-h2-sm" id="MtRevTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
    </div>
    <div class="mt-reviews" data-mt-reviews>
      {%- for block in section.blocks -%}
        <figure class="ca-review ca-reveal{% if forloop.index > visible %} mt-review--more{% endif %}" {% if forloop.index > visible %}hidden{% endif %} {{ block.shopify_attributes }}>
          {%- if section.settings.show_stars -%}<p class="mt-stars" aria-label="5 estrellas">★★★★★</p>{%- endif -%}
          <blockquote>“{{ block.settings.quote }}”</blockquote>
          <figcaption>{{ block.settings.author }} <span>{{ block.settings.source }}</span></figcaption>
        </figure>
      {%- endfor -%}
    </div>
    <div class="mt-center-actions">
      {%- if section.blocks.size > visible -%}
        <button class="ca-btn ca-btn--outline" type="button" data-mt-reviews-more>{{ section.settings.more_label }}</button>
      {%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.rating_link != blank -%}
        <a class="ca-link-arrow" href="{{ section.settings.rating_link }}" target="_blank" rel="noopener">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MT · Testimonios",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "ID de ancla", "default": "opiniones" },
    { "type": "checkbox", "id": "alt_bg", "label": "Fondo alternativo", "default": false },
    { "type": "text", "id": "rating", "label": "Calificación", "default": "4,8 ★ en Google" },
    { "type": "url", "id": "rating_link", "label": "Enlace a reseñas de Google" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Noches que se recuerdan." },
    { "type": "checkbox", "id": "show_stars", "label": "Mostrar estrellas en cada reseña", "default": true },
    { "type": "range", "id": "visible", "label": "Reseñas visibles al cargar", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "text", "id": "more_label", "label": "Botón ver más", "default": "Ver todas" },
    { "type": "text", "id": "link_label", "label": "Enlace a Google", "default": "Leer en Google" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Reseña",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Reseña" },
        { "type": "text", "id": "author", "label": "Autor" },
        { "type": "text", "id": "source", "label": "Fuente", "default": "Reseña de Google" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "MT · Testimonios" }]
}
{% endschema %}
