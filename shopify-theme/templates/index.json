    "eventos": {
      "type": "ca-eventos",
      "settings": {},
      "blocks": {
        "format_1": {
          "type": "format",
          "settings": {
            "number": "01",
            "title": "Solo Espacio",
            "text": "<p>Uso exclusivo del lugar para quienes desean trabajar con sus propios proveedores y producción. Ideal para matrimonios y eventos de gran formato con total libertad creativa.</p>"
          }
        },
        "format_2": {
          "type": "format",
          "settings": {
            "number": "02",
            "title": "Experiencia Completa",
            "text": "<p>Completamente producida y coordinada por Casa Alma. Nosotros nos encargamos de todo para que tú solo disfrutes.</p>",
            "checks": "Banquetería y bar\nMontaje e iluminación\nDJ y ambientación\nCoordinación del evento",
            "note": "Valor según número de invitados y menú. Cotiza sin compromiso.",
            "featured": true
          }
        },
        "feature_3": {
          "type": "feature",
          "settings": {
            "stat": "5.000 m²",
            "title": "Jardines privados",
            "text": "Un entorno verde y abierto, rodeado de campos y naturaleza, completamente exclusivo para tu evento."
          }
        },
        "feature_4": {
          "type": "feature",
          "settings": {
            "stat": "Piscina",
            "title": "Y áreas verdes",
            "text": "Piscina rodeada de jardines y espacios al aire libre para todos los momentos del día y la noche."
          }
        },
        "feature_5": {
          "type": "feature",
          "settings": {
            "stat": "Parking",
            "title": "Estacionamientos privados",
            "text": "Acceso cómodo para todos tus invitados, sin preocupaciones logísticas."
