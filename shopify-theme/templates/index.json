    "testimonios": {
      "type": "mt-testimonios",
      "settings": {
        "rating_link": "https://www.google.com/maps/search/?api=1&query=Casa+Alma+Liray+Colina"
      },
      "blocks": {
        "review_1": {
          "type": "review",
          "settings": {
            "quote": "Casa Alma Liray es una experiencia que sorprende cada vez. Ya he vivido más de tres de sus cenas maridaje y siempre logro descubrir algo nuevo. El lugar, el paisaje, la cálida acogida de sus anfitriones, la gastronomía, los vinos y los shows artísticos se combinan de una manera maravillosa. Cada cena está cuidada hasta el último detalle y se siente mucho más que una experiencia gastronómica. Sin duda, un lugar al que siempre dan ganas de volver.",
            "author": "Ro Pérez-Kallens Rojas",
            "source": "Reseña de Google"
          }
        },
        "review_2": {
          "type": "review",
          "settings": {
            "quote": "Una maravillosa experiencia, excelente gastronomía, anfitriones muy cercanos. Conoces mucha gente dado el ambiente de cercanía que le dan sus dueños.",
            "author": "Carolina Gonzalez",
            "source": "Reseña de Google"
          }
        },
        "review_3": {
          "type": "review",
          "settings": {
            "quote": "Un lugar para desconectar conectándose con la gastronomía y vino.",
            "author": "Miguel Wauters",
            "source": "Reseña de Google"
          }
        },
        "review_4": {
          "type": "review",
          "settings": {
            "quote": "Excelente lugar y una experiencia increíble. Realmente todo muy bueno.",
            "author": "Carolina Salinas",
            "source": "Reseña de Google"
          }
        },
        "review_5": {
          "type": "review",
          "settings": {
            "quote": "Excelente lugar y experiencia cerca de Santiago, lo mejor.",
            "author": "Cristian Carrasco Guerrero",
            "source": "Reseña de Google"
          }
        }
      },
      "block_order": [
        "review_1",
        "review_2",
        "review_3",
        "review_4",
        "review_5"
      ]
